{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "builtin": "schedule",
  "args": [
    "*/1 * * * *",
    "uv",
    "run",
    "--with-requirements",
    "/usr/local/google/home/shacharb/skynet/requirements.txt",
    "python3",
    "/usr/local/google/home/shacharb/skynet/.agents/skills/closed-loop-learning/scripts/bug_to_lesson_processor.py",
    "--scan-dir",
    "/usr/local/google/home/shacharb/.gemini/jetski/bugs",
    "--delete-on-success"
  ],
  "restart_policy": "always",
  "description": "Scans the centralized bug inbox every 1 minute for verified FIXED bugs and ingests their problem-solution pairs into Firestore RAG memory via submit_lesson MCP tool."
}
